<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Telegram Bridge - long-poll network service (TelegramBridgeService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Phase 5: call-by-name (ContactsHelper + AppAutomationManager.callNumber/callContact) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Phase 6: scheduled actions (Scheduler/ScheduledActionReceiver). Scheduler.java already
         falls back to an inexact alarm if this isn't granted on Android 12+, so it's safe even
         if the user never opens Settings > Alarms & reminders to allow it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Phase 6: keep the foreground service alive (BatteryOptimizationHelper) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ (API 30+) hides other apps' packages from PackageManager unless either
         declared here or covered by QUERY_ALL_PACKAGES. Ultron's whole job is opening/automating
         dozens of other apps (see AppPackageMap), so it needs the broad grant - this is a
         sideloaded personal-use APK, not a Play Store submission, so the usual Play policy
         restriction on QUERY_ALL_PACKAGES doesn't apply here. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".UltronApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Ultron"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Ultron Heart"
            android:theme="@style/AppTheme" />

        <!-- Wake-word / typed-chat full-screen HUD. Needs to be launchable from the background
             service (see UltronService.wake()) and to draw over the lock screen. -->
        <activity
            android:name=".UltronHudActivity"
            android:exported="false"
            android:theme="@style/UltronHudTheme"
            android:launchMode="singleTask"
            android:excludeFromRecents="false" />

        <service
            android:name=".UltronService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Telegram Bridge - long-polls Telegram for messages from the one paired chat (see
             TelegramAuthManager) and routes them into UltronCore, same as voice/HUD text. -->
        <service
            android:name=".TelegramBridgeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".UltronAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ultron_accessibility_service" />
        </service>

        <receiver
            android:name=".DeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Phase 6: fires scheduled actions armed by Scheduler.java -->
        <receiver
            android:name=".ScheduledActionReceiver"
            android:exported="false" />

    </application>
</manifest>
